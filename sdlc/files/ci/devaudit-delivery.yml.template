# DevAudit Delivery run — a headless sdlc-implementer session (DevAudit-Installer#1272, #1273, #1274, #1286).
#
# Generated by `devaudit install --delivery` / `devaudit update` from sdlc-config.json
# (`delivery.enabled`). Do not edit manually — re-run the CLI (`devaudit update`) to regenerate.
#
# The DevAudit portal starts a run with a `repository_dispatch` event of type
# `devaudit-delivery` carrying `client_payload.runId` and `client_payload.issueNumber`.
# GitHub runs a repository_dispatch workflow from the DEFAULT branch, so this file
# must reach `{{RELEASE_BRANCH}}` (through the normal release) before the portal can start a run.
#
# The job checks out `{{INTEGRATION_BRANCH}}`, installs a pinned Claude Code CLI, and runs the
# sdlc-implementer skill on the issue with no person in the loop (the skill's "Headless
# (delivery run) rules"). The agent works under its own portal key and its own GitHub token and
# author, so the client's human approver is independent of the release's creator and submitter.
# The job stops at "awaiting approval": merge, deploy and close-out are driven by the usual gates
# after a person approves. See docs/delivery-runs.md.
#
# The agent's GitHub token (#1286). A push or pull request made with this workflow's own token
# starts no other workflow, so the release's CI would never run. The agent therefore uses either
# the repository secret DEVAUDIT_AGENT_GITHUB_TOKEN (a machine user's fine-grained token: the
# pilot path) or a short-lived token the portal mints from the DevAudit Agent GitHub App (the
# product path). `devaudit delivery github-token` resolves it before any agent work and fails the
# job when there is none: there is no fall back to the default token. The token lasts about an
# hour, so git and gh ask for a current one on every push and call (a credential helper and a gh
# shim); it is never stored in the checkout. The default token below is read-only.

name: DevAudit Delivery

on:
  repository_dispatch:
    types: [devaudit-delivery]

permissions:
  contents: read

# One run at a time per repository; the portal enforces the organisation-wide cap.
concurrency:
  group: delivery-${{ github.repository }}
  cancel-in-progress: false

jobs:
  delivery:
    name: Delivery run ${{ github.event.client_payload.runId }}
    runs-on: {{RUNNER}}
    timeout-minutes: {{DELIVERY_MAX_MINUTES}}
    env:
      RUN_ID: ${{ github.event.client_payload.runId }}
      ISSUE_NUMBER: ${{ github.event.client_payload.issueNumber }}
      # The agent's own GitHub token, when the repository has one (pilot). Empty otherwise: the
      # portal's GitHub App is asked. Never the default token.
      DEVAUDIT_AGENT_GITHUB_TOKEN: ${{ secrets.DEVAUDIT_AGENT_GITHUB_TOKEN || '' }}
      # The agent works under its own portal key (#1274): scripts and `devaudit delivery report` read it.
      DEVAUDIT_AGENT_PORTAL_KEY: ${{ secrets.DEVAUDIT_AGENT_PORTAL_KEY }}
      DEVAUDIT_API_KEY: ${{ secrets.DEVAUDIT_AGENT_PORTAL_KEY }}
      DEVAUDIT_BASE_URL: ${{ vars.DEVAUDIT_BASE_URL }}
      # The key the headless Claude Code session authenticates with.
      ANTHROPIC_API_KEY: ${{ secrets.DEVAUDIT_AGENT_API_KEY }}
      # A git command that cannot get a token must fail, never wait for a person.
      GIT_TERMINAL_PROMPT: '0'
    steps:
      - name: Check the dispatch payload and secrets
        run: |
          set -euo pipefail
          [[ "$RUN_ID" =~ ^[A-Za-z0-9_-]{1,64}$ ]] || { echo "::error::client_payload.runId is missing or not a plain id"; exit 1; }
          [[ "$ISSUE_NUMBER" =~ ^[0-9]{1,9}$ ]] || { echo "::error::client_payload.issueNumber is missing or not a number"; exit 1; }
          [ -n "$ANTHROPIC_API_KEY" ] || { echo "::error::repository secret DEVAUDIT_AGENT_API_KEY is not set"; exit 1; }
          [ -n "$DEVAUDIT_AGENT_PORTAL_KEY" ] || { echo "::error::repository secret DEVAUDIT_AGENT_PORTAL_KEY is not set"; exit 1; }

      # Read-only, and no credential is left in the checkout: the agent's pushes use its own token.
      - uses: actions/checkout@v6
        with:
          ref: {{INTEGRATION_BRANCH}}
          fetch-depth: 0
          token: ${{ github.token }}
          persist-credentials: false

{{DELIVERY_SETUP_STEPS}}

      - name: Install Claude Code and the DevAudit CLI
        run: npm install -g @anthropic-ai/claude-code@{{DELIVERY_CLAUDE_CODE_VERSION}} @metasession.co/devaudit-cli@{{DELIVERY_CLI_VERSION}}

      - name: Resolve the agent's GitHub token and author
        run: devaudit delivery github-token --run "$RUN_ID" --mask --github-env

      - name: Give git and gh the agent's identity
        run: |
          set -euo pipefail
          git config user.name "$DEVAUDIT_AGENT_GIT_NAME"
          git config user.email "$DEVAUDIT_AGENT_GIT_EMAIL"
          # A credential helper answers every git push with a current token; the empty value first
          # drops any helper configured elsewhere.
          git config credential.helper ''
          git config --add credential.helper '!devaudit delivery github-token --credential'
          # gh reads one token for the whole process: a shim ahead of it on PATH sets a current one per call.
          mkdir -p "$RUNNER_TEMP/devaudit-bin"
          printf '#!/usr/bin/env bash\nexec bash "%s/scripts/delivery-gh.sh" "$@"\n' "$GITHUB_WORKSPACE" > "$RUNNER_TEMP/devaudit-bin/gh"
          chmod +x "$RUNNER_TEMP/devaudit-bin/gh"
          echo "DEVAUDIT_REAL_GH=$(command -v gh)" >> "$GITHUB_ENV"
          echo "$RUNNER_TEMP/devaudit-bin" >> "$GITHUB_PATH"

      - name: Report the run as running
        run: devaudit delivery report --run "$RUN_ID" --phase running

      - name: Run the agent
        id: agent
        continue-on-error: true
        run: |
          set -euo pipefail
          PROMPT="$(sed -e "s/@@ISSUE_NUMBER@@/${ISSUE_NUMBER}/g" -e "s/@@RUN_ID@@/${RUN_ID}/g" {{DELIVERY_PROMPT_FILE}})"
          # An ephemeral runner with a scoped token: the session may not stop to ask. The skill's headless
          # rules name what it must never do (force-push, branch protection, secrets, approving).
          claude -p "$PROMPT" --output-format json --max-turns {{DELIVERY_MAX_TURNS}} --dangerously-skip-permissions > delivery-output.json

      - name: Report the end of the run
        if: always()
        env:
          AGENT_OUTCOME: ${{ steps.agent.outcome }}
        run: |
          set +e
          command -v devaudit >/dev/null 2>&1 || { echo "::warning::the DevAudit CLI was not installed, so the end of the run cannot be reported"; exit 0; }
          if [ "$AGENT_OUTCOME" = "success" ]; then
            PHASE=awaiting_approval
            REASON=""
          elif [ "$AGENT_OUTCOME" = "skipped" ]; then
            PHASE=failed
            REASON="the job stopped before the agent started (the GitHub token or an earlier step failed; see the job log)"
          else
            PHASE=failed
            REASON="the agent session ended with outcome ${AGENT_OUTCOME:-unknown}"
          fi
          ARGS=(--run "$RUN_ID" --phase "$PHASE" --ci-seconds "$SECONDS")
          [ -n "$REASON" ] && ARGS+=(--reason "$REASON")
          [ -f delivery-output.json ] && ARGS+=(--cost-file delivery-output.json)
          devaudit delivery report "${ARGS[@]}"
