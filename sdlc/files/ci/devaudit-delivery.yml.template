# DevAudit Delivery run — a headless sdlc-implementer session (DevAudit-Installer#1272, #1273, #1274).
#
# Generated by `devaudit install --delivery` / `devaudit update` from sdlc-config.json
# (`delivery.enabled`). Do not edit manually — re-run the CLI (`devaudit update`) to regenerate.
#
# The DevAudit portal starts a run with a `repository_dispatch` event of type
# `devaudit-delivery` carrying `client_payload.runId` and `client_payload.issueNumber`.
# GitHub runs a repository_dispatch workflow from the DEFAULT branch, so this file
# must reach `{{RELEASE_BRANCH}}` (through the normal release) before the portal can start a run.
#
# The job checks out `{{INTEGRATION_BRANCH}}`, installs a pinned Claude Code CLI, and runs the
# sdlc-implementer skill on the issue with no person in the loop (the skill's "Headless
# (delivery run) rules"). The agent works under its own portal key and git author, so the
# client's human approver is independent of the release's creator and submitter. The job stops
# at "awaiting approval": merge, deploy and close-out are driven by the usual gates after a
# person approves. See docs/delivery-runs.md.

name: DevAudit Delivery

on:
  repository_dispatch:
    types: [devaudit-delivery]

permissions:
  contents: write
  pull-requests: write
  issues: write
  actions: read

# One run at a time per repository; the portal enforces the organisation-wide cap.
concurrency:
  group: delivery-${{ github.repository }}
  cancel-in-progress: false

jobs:
  delivery:
    name: Delivery run ${{ github.event.client_payload.runId }}
    runs-on: {{RUNNER}}
    timeout-minutes: {{DELIVERY_MAX_MINUTES}}
    env:
      RUN_ID: ${{ github.event.client_payload.runId }}
      ISSUE_NUMBER: ${{ github.event.client_payload.issueNumber }}
      # A push or pull request made with the default token starts no workflow, so the
      # release's CI would never run. DEVAUDIT_AGENT_GITHUB_TOKEN (optional) lets it.
      GH_TOKEN: ${{ secrets.DEVAUDIT_AGENT_GITHUB_TOKEN || github.token }}
      # The agent works under its own portal key (#1274): scripts and `devaudit delivery report` read it.
      DEVAUDIT_AGENT_PORTAL_KEY: ${{ secrets.DEVAUDIT_AGENT_PORTAL_KEY }}
      DEVAUDIT_API_KEY: ${{ secrets.DEVAUDIT_AGENT_PORTAL_KEY }}
      DEVAUDIT_BASE_URL: ${{ vars.DEVAUDIT_BASE_URL }}
      # The key the headless Claude Code session authenticates with.
      ANTHROPIC_API_KEY: ${{ secrets.DEVAUDIT_AGENT_API_KEY }}
    steps:
      - name: Check the dispatch payload and secrets
        run: |
          set -euo pipefail
          [[ "$RUN_ID" =~ ^[A-Za-z0-9_-]{1,64}$ ]] || { echo "::error::client_payload.runId is missing or not a plain id"; exit 1; }
          [[ "$ISSUE_NUMBER" =~ ^[0-9]{1,9}$ ]] || { echo "::error::client_payload.issueNumber is missing or not a number"; exit 1; }
          [ -n "$ANTHROPIC_API_KEY" ] || { echo "::error::repository secret DEVAUDIT_AGENT_API_KEY is not set"; exit 1; }
          [ -n "$DEVAUDIT_AGENT_PORTAL_KEY" ] || { echo "::error::repository secret DEVAUDIT_AGENT_PORTAL_KEY is not set"; exit 1; }

      - uses: actions/checkout@v6
        with:
          ref: {{INTEGRATION_BRANCH}}
          fetch-depth: 0
          token: ${{ secrets.DEVAUDIT_AGENT_GITHUB_TOKEN || github.token }}

{{DELIVERY_SETUP_STEPS}}

      - name: Git identity of the agent
        run: |
          git config user.name "{{DELIVERY_GIT_AUTHOR_NAME}}"
          git config user.email "{{DELIVERY_GIT_AUTHOR_EMAIL}}"

      - name: Install Claude Code and the DevAudit CLI
        run: npm install -g @anthropic-ai/claude-code@{{DELIVERY_CLAUDE_CODE_VERSION}} @metasession.co/devaudit-cli@{{DELIVERY_CLI_VERSION}}

      - name: Report the run as running
        run: devaudit delivery report --run "$RUN_ID" --phase running

      - name: Run the agent
        id: agent
        continue-on-error: true
        run: |
          set -euo pipefail
          PROMPT="$(sed -e "s/@@ISSUE_NUMBER@@/${ISSUE_NUMBER}/g" -e "s/@@RUN_ID@@/${RUN_ID}/g" {{DELIVERY_PROMPT_FILE}})"
          # An ephemeral runner with a scoped token: the session may not stop to ask. The skill's
          # headless rules name what it must never do (force-push, branch protection, secrets, approving).
          claude -p "$PROMPT" --output-format json --max-turns {{DELIVERY_MAX_TURNS}} --dangerously-skip-permissions > delivery-output.json

      - name: Report the end of the run
        if: always()
        env:
          AGENT_OUTCOME: ${{ steps.agent.outcome }}
        run: |
          set +e
          if [ "$AGENT_OUTCOME" = "success" ]; then
            PHASE=awaiting_approval
            REASON=""
          else
            PHASE=failed
            REASON="the agent session ended with outcome ${AGENT_OUTCOME:-unknown}"
          fi
          ARGS=(--run "$RUN_ID" --phase "$PHASE" --ci-seconds "$SECONDS")
          [ -n "$REASON" ] && ARGS+=(--reason "$REASON")
          [ -f delivery-output.json ] && ARGS+=(--cost-file delivery-output.json)
          devaudit delivery report "${ARGS[@]}"
