# Feature-branch in-scope tests, pytest runner (DEVAUDIT-003, issue #174; devaudit-installer#1060)
#
# Selected instead of feature-e2e.yml.template when sdlc-config.json sets
# test_runner to "pytest". Same release registration, execution lifecycle and
# stage-2 origin=feature evidence as feature-e2e.yml.template; the tests run
# through scripts/run-test-tier.sh and the JUnit XML is the e2e_result.
# Tests are found by requirement id anywhere under tests/ (test name, marker
# or docstring containing REQ-XXX).
#
# Generated by `devaudit install` / `devaudit update` from sdlc-config.json.
# Runs the E2E specs tagged with the branch's REQ on PRs to the integration
# branch, so regression-tier bugs surface during the feature execution instead of
# at the release gate. Uploads the report as stage-2, origin=feature evidence
# so it does NOT co-mingle with the stage-3/5 regression runs and is NOT
# counted as release/UAT evidence by the portal.
name: Feature In-Scope E2E

on:
  pull_request:
    branches: [{{INTEGRATION_BRANCH}}]

jobs:
  detect-req:
    name: Detect REQ from branch
    if: ${{ !startsWith(github.head_ref, 'chore/close-out-') }}
    runs-on: {{RUNNER}}
    outputs:
      req_id: ${{ steps.detect.outputs.req_id }}
      has_tests: ${{ steps.detect.outputs.has_tests }}
    steps:
      - uses: actions/checkout@v6
        with:
          fetch-depth: 0
          # See ci.yml.template's checkout step for why (devaudit-installer#676/#815).
          clean: {{CHECKOUT_CLEAN}}
      - name: Parse REQ from branch name
        id: detect
        run: |
          BRANCH="${{ github.head_ref }}"
          BASE_REF="${{ github.base_ref }}"

          # Primary: scan the PR's own commits for a Ref: REQ-XXX trailer or a
          # bracketed [REQ-XXX] tag. commitlint already enforces Ref: REQ-XXX
          # on every feat/fix/refactor/perf commit, making this the reliable
          # source of REQ-scope — unlike the branch name, which is an
          # unenforced convention (DevAudit-Installer#580: a branch named
          # after its GitHub issue number rather than its REQ id, e.g.
          # fix/603-req095-post-merge-regression-fixes, never matched the
          # branch-name regex even though every commit on it carried a
          # correct Ref: REQ-095 trailer, so the tagged spec silently never
          # ran).
          BASE_SHA=$(git merge-base "origin/${BASE_REF}" HEAD 2>/dev/null || echo '')
          RANGE_REQS=""
          if [ -n "$BASE_SHA" ]; then
            RANGE_REQS=$(git log "${BASE_SHA}..HEAD" --pretty=%B 2>/dev/null \
              | grep -ioE '(\[REQ-[0-9]+\]|Ref:[[:space:]]*REQ-[0-9]+)' \
              | grep -oiE 'REQ-[0-9]+' | tr '[:lower:]' '[:upper:]' | sort -u || true)
          fi
          RANGE_REQ_COUNT=$(echo "$RANGE_REQS" | grep -c . || true)

          # devaudit-installer#1019 -- a PR that changes no code (documentation /
          # compliance records only, or an explicit `Compliance-Record: REQ-XXX`
          # trailer) is not the release's own work: it must not attach test
          # executions, its head SHA or its branch to that REQ's release. Its
          # documents still reach the release through compliance-evidence.yml.
          ATTRIBUTION=attach
          if [ -f scripts/classify-pr-attribution.sh ]; then
            ATTRIBUTION=$(bash scripts/classify-pr-attribution.sh --base "origin/${BASE_REF}" 2>/dev/null || echo attach)
          fi

          REQ_ID=""
          if [[ "$ATTRIBUTION" == skip:* ]]; then
            echo "::notice::Feature E2E not attributing this PR to any release (${ATTRIBUTION#skip:}): it changes no code, so it must not move a release's tested SHA, branch or executions (devaudit-installer#1019)."
          elif [ "$RANGE_REQ_COUNT" = "1" ]; then
            REQ_ID="$RANGE_REQS"
          elif [[ $BRANCH =~ (REQ-[0-9]+) ]]; then
            # Fallback: branch-name regex, best-effort when no commit in
            # range carries a trailer (e.g. a docs-only or
            # pre-commitlint-era commit).
            REQ_ID="${BASH_REMATCH[1]}"
          fi

          if [[ "$ATTRIBUTION" == skip:* ]]; then
            echo "req_id=none" >> "$GITHUB_OUTPUT"
            echo "has_tests=false" >> "$GITHUB_OUTPUT"
          elif [ -n "$REQ_ID" ]; then
            echo "req_id=$REQ_ID" >> "$GITHUB_OUTPUT"
            if grep -rl "$REQ_ID" {{WORKING_DIR_PREFIX}}tests/ --include="*.py" >/dev/null 2>&1; then
              echo "has_tests=true" >> "$GITHUB_OUTPUT"
            else
              echo "has_tests=false" >> "$GITHUB_OUTPUT"
            fi
          else
            echo "req_id=none" >> "$GITHUB_OUTPUT"
            echo "has_tests=false" >> "$GITHUB_OUTPUT"
            # Visible instead of silent (DevAudit-Installer#580 Option C):
            # a skip here means feature-stage E2E verification did not run
            # for this PR at all, which no other check surfaces.
            if [ "$RANGE_REQ_COUNT" -gt 1 ] 2>/dev/null; then
              echo "::warning::PR commits carry multiple distinct REQ tags ($(echo "$RANGE_REQS" | tr '\n' ' ')) and the branch name (${BRANCH}) doesn't disambiguate — skipping feature E2E. This workflow scopes one REQ per PR; split bundled REQs into separate PRs or verify this one's E2E coverage manually."
            else
              echo "::warning::No REQ could be determined for this PR from commit trailers (${BASE_SHA:-<no base>}..HEAD) or the branch name (${BRANCH}) — feature E2E is being skipped, not verified. If this PR is tracked, ensure at least one commit carries a 'Ref: REQ-XXX' trailer."
            fi
          fi
      # devaudit-installer#737: has_tests=false is ambiguous by itself — it
      # covers both "sdlc-implementer/e2e-test-engineer deliberately decided
      # no e2e was needed" (a committed compliance/evidence/<REQ>/
      # e2e-scope-decision.md proves it) and "a real coverage gap" (no such
      # file). Upload the artefact when it exists so the deliberate case
      # stops reading as silence beyond this workflow's log; leave the
      # ::warning:: above as the only signal for the genuinely-ambiguous
      # case, per the issue's explicit out-of-scope note.
      - name: Upload e2e-scope-decision evidence, if the deliberate-skip artefact was committed
        if: steps.detect.outputs.has_tests == 'false' && steps.detect.outputs.req_id != 'none'
        env:
          DEVAUDIT_BASE_URL_VAR: ${{ vars.DEVAUDIT_BASE_URL }}
          DEVAUDIT_API_KEY: ${{ secrets.{{API_KEY_SECRET}} }}
        run: |
          REQ_ID="${{ steps.detect.outputs.req_id }}"
          ARTEFACT="compliance/evidence/${REQ_ID}/e2e-scope-decision.md"
          if [ ! -f "$ARTEFACT" ]; then
            echo "No $ARTEFACT on this branch — leaving the has_tests=false warning above as the only signal (ambiguous case, unchanged)."
            exit 0
          fi
          CONFIG_URL=""
          if [ -f "$GITHUB_WORKSPACE/sdlc-config.json" ]; then
            CONFIG_URL=$(jq -r '.devaudit.base_url // empty' "$GITHUB_WORKSPACE/sdlc-config.json" 2>/dev/null || true)
          fi
          BASE="${CONFIG_URL:-$DEVAUDIT_BASE_URL_VAR}"
          if [ -z "$BASE" ] || [ -z "$DEVAUDIT_API_KEY" ]; then
            echo "::warning::DevAudit not configured — skipping e2e-scope-decision upload."
            exit 0
          fi
          export DEVAUDIT_BASE_URL="${BASE%/}"
          chmod +x "$GITHUB_WORKSPACE/scripts/upload-evidence.sh" 2>/dev/null || true
          bash "$GITHUB_WORKSPACE/scripts/upload-evidence.sh" \
            {{PROJECT_SLUG}} "$REQ_ID" e2e_scope_decision "$ARTEFACT" \
            --category planning --release "$REQ_ID" --create-release-if-missing \
            --environment uat --sdlc-stage 3 \
            --git-sha "${{ github.event.pull_request.head.sha }}" \
            --branch "${{ github.head_ref }}"

  run-feature-e2e:
    name: Run in-scope E2E
    needs: detect-req
    if: needs.detect-req.outputs.has_tests == 'true'
    runs-on: {{RUNNER}}

    # See ci.yml.template's quality-gates job for why this exists (#689
    # polyglot-monorepo subdir targets, e.g. a consumer's example-web/).
    # scripts/ stays repo-root-relative below (via $GITHUB_WORKSPACE) since
    # register-release-style tooling lives there regardless of target.
    defaults:
      run:
        working-directory: {{WORKING_DIRECTORY}}

    services:
      {{DATABASE_SERVICE}}:
        image: {{DATABASE_IMAGE}}
{{DATABASE_SERVICE_ENV}}
        ports:
          - {{DATABASE_PORT}}
{{DATABASE_SERVICE_OPTIONS}}

    env:
{{DATABASE_AND_APP_ENV}}
      DEVAUDIT_BASE_URL_VAR: ${{ vars.DEVAUDIT_BASE_URL }}
      DEVAUDIT_API_KEY: ${{ secrets.{{API_KEY_SECRET}} }}

    steps:
      - uses: actions/checkout@v6
        with:
          fetch-depth: 0
          # See ci.yml.template's checkout step for why (devaudit-installer#676/#815).
          clean: {{CHECKOUT_CLEAN}}

      - name: Clean stale test output (self-hosted only)
        # See ci.yml.template's step of the same name (devaudit-installer#816/#1054).
        if: {{STALE_NEXT_CLEANUP_IF}}
        run: rm -rf "$GITHUB_WORKSPACE"/feature-e2e-results.xml .pytest_cache

      - uses: actions/setup-python@v6
        with:
          python-version: '{{PYTEST_PYTHON_VERSION}}'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          if [ -f pyproject.toml ]; then pip install -e ".[dev]" || pip install -e .; fi
          if [ -f requirements.txt ]; then pip install -r requirements.txt; fi
          pip install pytest

{{DATABASE_URI_STEP}}
{{E2E_SETUP_STEP}}
      - name: Register feature release and start feature E2E execution
        id: exec
        if: always()
        run: |
          REQ_ID="${{ needs.detect-req.outputs.req_id }}"
          : > "$GITHUB_OUTPUT"
          CONFIG_URL=""
          # sdlc-config.json lives at the repo root (#689 follow-up), not this
          # job's working-directory (a target's own subdirectory).
          if [ -f "$GITHUB_WORKSPACE/sdlc-config.json" ]; then
            CONFIG_URL=$(jq -r '.devaudit.base_url // empty' "$GITHUB_WORKSPACE/sdlc-config.json" 2>/dev/null || true)
          fi
          BASE="${CONFIG_URL:-$DEVAUDIT_BASE_URL_VAR}"
          if [ -z "$BASE" ] || [ -z "$DEVAUDIT_API_KEY" ]; then
            echo "::warning::DevAudit not configured — skipping feature E2E test execution lifecycle."
            echo "execution_supported=false" >> "$GITHUB_OUTPUT"
            exit 0
          fi
          export DEVAUDIT_BASE_URL="${BASE%/}"
          chmod +x $GITHUB_WORKSPACE/scripts/upload-evidence.sh $GITHUB_WORKSPACE/scripts/report-test-execution.sh 2>/dev/null || true
          bash $GITHUB_WORKSPACE/scripts/upload-evidence.sh \
            {{PROJECT_SLUG}} _compliance-docs release_registration README.md \
            --release "$REQ_ID" --create-release-if-missing \
            --environment uat --category planning \
            --git-sha "${{ github.event.pull_request.head.sha }}" \
            --branch "${{ github.head_ref }}" || true
          bash $GITHUB_WORKSPACE/scripts/report-test-execution.sh start \
            --project-slug {{PROJECT_SLUG}} \
            --release "$REQ_ID" \
            --sdlc-stage 2 \
            --environment uat \
            --suite-kind e2e \
            --provider github_actions \
            --external-run-id "${{ github.run_id }}" \
            --external-run-attempt "${{ github.run_attempt }}" \
            --idempotency-key "github:${{ github.repository }}:feature-in-scope-e2e.e2e:${{ github.run_id }}:${{ github.run_attempt }}:2:${REQ_ID}" \
            --commit-sha "${{ github.event.pull_request.head.sha }}" \
            --branch "${{ github.head_ref }}" \
            --workflow-name "Feature In-Scope E2E" \
            --workflow-url "${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}" \
            --output-file "$GITHUB_OUTPUT"

{{E2E_FEATURE_TEST_STEP}}
      - name: Upload feature E2E evidence (stage 2, origin=feature)
        if: always()
        run: |
          REQ_ID="${{ needs.detect-req.outputs.req_id }}"
          CONFIG_URL=""
          # sdlc-config.json lives at the repo root (#689 follow-up), not this
          # job's working-directory (a target's own subdirectory).
          if [ -f "$GITHUB_WORKSPACE/sdlc-config.json" ]; then
            CONFIG_URL=$(jq -r '.devaudit.base_url // empty' "$GITHUB_WORKSPACE/sdlc-config.json" 2>/dev/null || true)
          fi
          BASE="${CONFIG_URL:-$DEVAUDIT_BASE_URL_VAR}"
          if [ -z "$BASE" ] || [ -z "$DEVAUDIT_API_KEY" ]; then
            echo "::warning::DevAudit not configured — skipping feature E2E upload."
            exit 0
          fi
          export DEVAUDIT_BASE_URL="${BASE%/}"
          LINEAGE_FLAGS=(--test-execution "${{ github.run_id }}")
          if [ "${{ steps.exec.outputs.execution_supported }}" = "true" ] && [ -n "${{ steps.exec.outputs.execution_record_id }}" ]; then
            LINEAGE_FLAGS+=(--evidence-scope execution --test-execution-record-id "${{ steps.exec.outputs.execution_record_id }}")
          fi
          UPLOAD_FAILURES=0

          RESULTS="$GITHUB_WORKSPACE/feature-e2e-results.xml"
          if [ ! -f "$RESULTS" ]; then
            echo "::error::Feature tests produced no feature-e2e-results.xml (a test_feature_command must write JUnit XML to \$TEST_JUNIT_XML)"
            exit 1
          fi
          bash $GITHUB_WORKSPACE/scripts/upload-evidence.sh \
            {{PROJECT_SLUG}} "$REQ_ID" e2e_result "$RESULTS" \
            --category e2e_result --release "$REQ_ID" --create-release-if-missing \
            --environment uat --sdlc-stage 2 \
            --git-sha "${{ github.event.pull_request.head.sha }}" \
            --ci-run-id "${{ github.run_id }}" --branch "${{ github.head_ref }}" \
            "${LINEAGE_FLAGS[@]}" \
            --meta-key "origin=feature" \
            || UPLOAD_FAILURES=$((UPLOAD_FAILURES + 1))

          if [ "$UPLOAD_FAILURES" -gt 0 ]; then
            echo "::error::${UPLOAD_FAILURES} feature E2E evidence upload(s) failed"
            exit 1
          fi

      - name: Complete feature E2E execution
        if: always()
        run: |
          if [ "${{ steps.exec.outputs.execution_supported }}" != "true" ] || [ -z "${{ steps.exec.outputs.execution_record_id }}" ]; then
            exit 0
          fi
          CONFIG_URL=""
          # sdlc-config.json lives at the repo root (#689 follow-up), not this
          # job's working-directory (a target's own subdirectory).
          if [ -f "$GITHUB_WORKSPACE/sdlc-config.json" ]; then
            CONFIG_URL=$(jq -r '.devaudit.base_url // empty' "$GITHUB_WORKSPACE/sdlc-config.json" 2>/dev/null || true)
          fi
          BASE="${CONFIG_URL:-$DEVAUDIT_BASE_URL_VAR}"
          if [ -z "$BASE" ] || [ -z "$DEVAUDIT_API_KEY" ]; then
            exit 0
          fi
          case "${{ job.status }}" in
            success)   OUTCOME=passed ;;
            cancelled) OUTCOME=cancelled ;;
            *)         OUTCOME=failed ;;
          esac
          export DEVAUDIT_BASE_URL="${BASE%/}"
          chmod +x $GITHUB_WORKSPACE/scripts/report-test-execution.sh 2>/dev/null || true
          bash $GITHUB_WORKSPACE/scripts/report-test-execution.sh complete \
            --project-slug {{PROJECT_SLUG}} \
            --release "${{ needs.detect-req.outputs.req_id }}" \
            --sdlc-stage 2 \
            --environment uat \
            --suite-kind e2e \
            --provider github_actions \
            --external-run-id "${{ github.run_id }}" \
            --external-run-attempt "${{ github.run_attempt }}" \
            --idempotency-key "github:${{ github.repository }}:feature-in-scope-e2e.e2e:${{ github.run_id }}:${{ github.run_attempt }}:2:${{ needs.detect-req.outputs.req_id }}" \
            --commit-sha "${{ github.event.pull_request.head.sha }}" \
            --branch "${{ github.head_ref }}" \
            --workflow-name "Feature In-Scope E2E" \
            --workflow-url "${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}" \
            --started-at "${{ steps.exec.outputs.execution_started_at }}" \
            --outcome "$OUTCOME"
