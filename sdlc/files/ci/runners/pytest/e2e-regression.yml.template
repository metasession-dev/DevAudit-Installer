# E2E Regression — three-tier gating model, pytest runner (devaudit-installer#1060).
#
# Selected instead of e2e-regression.yml.template when sdlc-config.json sets
# test_runner to "pytest". Same triggers, workflow/job/artifact names and
# portal check labels, so compliance-evidence.yml reports it identically:
# critical on a PR into the release branch, the full tier after a successful
# production deployment or on manual dispatch. The tiers run through
# scripts/run-test-tier.sh (pytest markers by default) and write JUnit XML.
#
# Generated by `devaudit install` / `devaudit update` from sdlc-config.json
# (opt-in via e2e_regression_enabled — DevAudit-Installer#821).
# Do not edit manually — re-run the CLI (`devaudit update`) to regenerate.
#
# Tiers (see SDLC/Test_Strategy.md § "E2E gating model — three tiers"):
#
#   - smoke      — runs on develop push via ci.yml (no change here)
#   - critical   — `pytest -m "smoke or critical"` by default
#                  (this workflow on PR-to-main)
#   - full       — `pytest` by default, after a successful production
#                  deployment status, or manual dispatch
#
# Override a tier with test_tier_critical / test_tier_full in sdlc-config.json;
# a custom command must write JUnit XML to $TEST_JUNIT_XML. The PR-to-main path
# runs the critical tier so velocity isn't blocked on the full suite. The
# post-deployment path runs the full tier against the deployed SHA and
# auto-files a `bug, priority:high` issue on failure.

name: E2E Regression

on:
  workflow_dispatch:
    inputs:
      specs:
        description: 'Space-separated spec paths or --grep pattern. Empty = full regression. Used during fix-and-verify iterations to keep the loop fast.'
        required: false
        type: string
        default: ''
      runner_label:
        description: 'Optional one-run runner label override. Blank uses repository CI_RUNNER_LABEL.'
        required: false
{{E2E_REGRESSION_TRIGGERS}}

concurrency:
{{E2E_REGRESSION_CONCURRENCY}}

permissions:
  contents: read
  issues: write # post-merge auto-issue on regression failure

jobs:
  e2e-regression:
    name: E2E Regression Suite
    if: >-
      github.event_name != 'deployment_status' ||
      (github.event.deployment_status.state == 'success' &&
       (github.event.deployment.environment == 'production' ||
        github.event.deployment.environment == 'prod' ||
        endsWith(github.event.deployment.environment, '/ production')))
    runs-on: {{RUNNER}}
    defaults:
      run:
        working-directory: {{WORKING_DIRECTORY}}
    # Keep the job budget above the 40-minute test budget so timeout metadata
    # and partial evidence can be retained before GitHub terminates the runner.
    # Configurable via sdlc-config.json's e2e_regression_timeout_minutes
    # (default 55, devaudit-installer#928).
    timeout-minutes: {{E2E_REGRESSION_TIMEOUT_MINUTES}}

    services:
      {{DATABASE_SERVICE}}:
        image: {{DATABASE_IMAGE}}
{{DATABASE_SERVICE_ENV}}
        ports:
          - {{DATABASE_PORT}}
{{DATABASE_SERVICE_OPTIONS}}

{{E2E_REGRESSION_JOB_ENV}}

    steps:
      - uses: actions/checkout@v6
        with:
          fetch-depth: 0
          ref: {{E2E_REGRESSION_CHECKOUT_REF}}
          clean: {{CHECKOUT_CLEAN}}

      - name: Clean stale test output (self-hosted only)
        # See ci.yml.template's step of the same name (devaudit-installer#816/#1054).
        if: {{STALE_NEXT_CLEANUP_IF}}
        run: rm -rf "$GITHUB_WORKSPACE"/e2e-regression-results*.xml "$GITHUB_WORKSPACE"/e2e-regression-metadata.json .pytest_cache

      - uses: actions/setup-python@v6
        with:
          python-version: '{{PYTEST_PYTHON_VERSION}}'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          if [ -f pyproject.toml ]; then pip install -e ".[dev]" || pip install -e .; fi
          if [ -f requirements.txt ]; then pip install -r requirements.txt; fi
          pip install pytest

{{DATABASE_URI_STEP}}
{{E2E_SETUP_STEP}}
      # Decide which tier to run based on the trigger: critical on the PR into
      # the release branch, the full tier after a production deployment, and
      # the full tier (optionally scoped to given pytest arguments) on manual
      # dispatch.
      - name: Determine test tier + selector
        id: select
        env:
          SPECS_INPUT: ${{ github.event.inputs.specs }}
        run: |
          set -euo pipefail
          case "${{ github.event_name }}" in
            pull_request)
              echo "tier={{E2E_PR_TIER}}" >> "$GITHUB_OUTPUT"
              echo "specs=" >> "$GITHUB_OUTPUT"
              ;;
            deployment_status|schedule)
              echo "tier=full" >> "$GITHUB_OUTPUT"
              echo "specs=" >> "$GITHUB_OUTPUT"
              echo "Running the full tier"
              ;;
            workflow_dispatch)
              echo "tier=full" >> "$GITHUB_OUTPUT"
              printf 'specs=%s\n' "${SPECS_INPUT//$'\n'/ }" >> "$GITHUB_OUTPUT"
              if [ -n "$SPECS_INPUT" ]; then
                echo "Scoped dispatch: $SPECS_INPUT"
              fi
              ;;
          esac

      - name: Record test execution context
        env:
          TIER: ${{ steps.select.outputs.tier }}
          SPECS: ${{ steps.select.outputs.specs }}
        run: |
          set -euo pipefail
          jq -n \
            --arg project "$TIER" \
            --arg tier "$TIER" \
            --arg specs "$SPECS" \
            --arg startedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
            --argjson timeoutMinutes 40 \
            '{target_url: "", project: $project, tier: $tier, selected_specs: $specs, test_server_start: "none", test_server_stop: "none", timeout_minutes: $timeoutMinutes, started_at: $startedAt, outcome: "running"}' \
            > "$GITHUB_WORKSPACE/e2e-regression-metadata.json"

      - name: E2E Regression Tests
        env:
          TIER: ${{ steps.select.outputs.tier }}
          SPECS: ${{ steps.select.outputs.specs }}
          TEST_JUNIT_XML: ${{ github.workspace }}/e2e-regression-results.xml
        run: |
          set -uo pipefail
          if [ -n "$SPECS" ]; then
            echo "::notice::Running scoped tests — specs=$SPECS"
            # shellcheck disable=SC2086
            timeout --signal=TERM --kill-after=60s 40m pytest $SPECS --junit-xml="$TEST_JUNIT_XML"
            STATUS=$?
          else
            echo "::notice::Running tier=$TIER"
            timeout --signal=TERM --kill-after=60s 40m bash "$GITHUB_WORKSPACE/scripts/run-test-tier.sh" "$TIER"
            STATUS=$?
          fi
          if [ "$STATUS" -eq 124 ]; then
            OUTCOME="timed_out"
            echo "::error::Regression tests exceeded their execution budget. Partial evidence will be uploaded."
          elif [ "$STATUS" -eq 0 ]; then
            OUTCOME="passed"
          else
            OUTCOME="failed"
          fi
          METADATA="$GITHUB_WORKSPACE/e2e-regression-metadata.json"
          jq --arg outcome "$OUTCOME" --arg completedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --argjson exitCode "$STATUS" \
            '. + {outcome: $outcome, completed_at: $completedAt, exit_code: $exitCode}' \
            "$METADATA" > "$METADATA.tmp"
          mv "$METADATA.tmp" "$METADATA"
          exit "$STATUS"

      - uses: actions/upload-artifact@v4
        if: always()
        continue-on-error: true
        with:
          name: e2e-regression-report
          path: |
            e2e-regression-results*.xml
            e2e-regression-metadata.json
          if-no-files-found: warn
          retention-days: 30

      # ─────────────────────────────────────────────────────────────────
      # Post-deployment auto-issue on regression failure.
      #
      # The 3-tier model's safety net: catches regressions that slipped
      # past the critical-tier PR gate. Opens a `bug, priority:high`
      # issue tagging the merge commit + the failing specs so the
      # operator can triage within working hours.
      #
      # No auto-revert — that's intentionally an operator decision per
      # the framework. False positives + flakes + UAT-data drift are
      # real classes; the operator handles each individually (hotfix,
      # revert, or accept-with-recorded-rationale).
      # ─────────────────────────────────────────────────────────────────
      - name: Open hotfix issue on post-merge regression
        if: failure() && github.event_name == 'deployment_status' && github.event.deployment_status.state == 'success'
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          MERGE_SHA="${{ github.sha }}"
          MERGE_SHA_SHORT=$(echo "$MERGE_SHA" | cut -c1-7)
          RUN_URL="${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}"

          # Extract failing test names from the JUnit XML if available.
          FAILING=""
          if [ -f "$GITHUB_WORKSPACE/e2e-regression-results.xml" ]; then
            FAILING=$(python3 -c '
          import sys
          import xml.etree.ElementTree as ET
          try:
              root = ET.parse(sys.argv[1]).getroot()
          except Exception:
              sys.exit(0)
          for case in root.iter("testcase"):
              if case.find("failure") is not None or case.find("error") is not None:
                  print(case.get("classname", "") + "::" + case.get("name", ""))
          ' "$GITHUB_WORKSPACE/e2e-regression-results.xml" 2>/dev/null | head -20 || true)
          fi
          if [ -z "$FAILING" ]; then
            FAILING="(see the failing run logs — could not parse test names from the JUnit XML)"
          fi

          BODY=$(cat <<EOF
          ## Post-merge regression caught on \`{{RELEASE_BRANCH}}\`

          The full regression suite failed on the post-merge run for commit \`${MERGE_SHA_SHORT}\`. The critical-tier PR gate let this slip through.

          **Failing tests (best-effort extracted from the JUnit XML):**

          \`\`\`
          ${FAILING}
          \`\`\`

          **Triage actions:**

          - [ ] Read the run log: ${RUN_URL}
          - [ ] Pull \`e2e-regression-report\` artifact from the run; inspect \`e2e-regression-results.xml\` for the failure details
          - [ ] Decide: hotfix on \`{{RELEASE_BRANCH}}\`, revert \`${MERGE_SHA_SHORT}\`, or accept-with-rationale if the failure is environmental
          - [ ] If the failing spec is a Must-tier candidate that should have caught this pre-merge, mark it \`@pytest.mark.critical\` so the next PR-to-main runs it

          **Auto-filed by:** \`e2e-regression.yml\` (DevAudit-Installer#821 3-tier gating)
          EOF
          )

          gh issue create \
            --title "[hotfix] Post-merge regression on \`${MERGE_SHA_SHORT}\` — full E2E failed" \
            --body "$BODY" \
            --label "bug,priority:high"
{{E2E_REGRESSION_SCHEDULE_ISSUE_STEP}}
