# Deploy for the `custom` host adapter (AWS, self-hosted, any script) -- devaudit-installer#1022
#
# Generated by `devaudit install` / `devaudit update` from sdlc-config.json.
# Do not edit manually -- re-run the CLI (`devaudit update`) to regenerate.
#
# Hosts like Vercel and Railway post a GitHub deployment status themselves. A deploy you
# run does not, so the production gate (post-deploy-prod.yml) would never fire. This
# workflow runs `deploy_command`, records the GitHub deployment, verifies the new build is
# serving, posts the terminal status, and then dispatches post-deploy-prod.yml with the
# deployed SHA (a status created with GITHUB_TOKEN does not trigger other workflows).

name: Deploy (custom host)

on:
{{DEPLOY_TRIGGER_BLOCK}}
  workflow_dispatch:
    inputs:
      runner_label:
        description: 'Optional one-run runner label override. Blank uses repository CI_RUNNER_LABEL.'
        required: false

concurrency:
  group: deploy-production
  cancel-in-progress: false

jobs:
  deploy:
    name: Deploy to production
    runs-on: {{RUNNER}}
    permissions:
      contents: read
      deployments: write
      actions: write
    env:
      GH_TOKEN: ${{ github.token }}
      PROD_URL: ${{ secrets.{{PRODUCTION_URL_SECRET}} }}
      DEVAUDIT_PROBE_HEADER: ${{ secrets.DEVAUDIT_PROBE_HEADER }}
      DEPLOY_SHA: ${{ github.sha }}
      DEPLOY_ENVIRONMENT: production
    steps:
      - uses: actions/checkout@v6
        with:
          ref: ${{ github.sha }}
          # See ci.yml.template's checkout step for why (devaudit-installer#676/#815).
          clean: {{CHECKOUT_CLEAN}}

      - name: Create GitHub deployment
        id: deployment
        run: |
          chmod +x scripts/record-custom-deployment.sh
          ID=$(bash scripts/record-custom-deployment.sh create --repo="${{ github.repository }}" --sha="$DEPLOY_SHA" --description="Deploy ${DEPLOY_SHA:0:7}")
          echo "id=${ID}" >> "$GITHUB_OUTPUT"
          bash scripts/record-custom-deployment.sh status --repo="${{ github.repository }}" --deployment-id="$ID" --state=in_progress --description="Running deploy_command"

      - name: Run deploy command
        env:
          DEVAUDIT_DEPLOY: '1'
          {{DEPLOY_SECRETS_ENV}}
        run: |
{{DEPLOY_COMMAND}}

      - name: Verify the new build is serving
        run: |
          chmod +x scripts/record-custom-deployment.sh
          VERIFY=(--sha="$DEPLOY_SHA" --health-url="${PROD_URL}/")
          if [ -n "{{DEPLOYED_SHA_URL}}" ]; then
            VERIFY=(--sha="$DEPLOY_SHA" --sha-url="{{DEPLOYED_SHA_URL}}")
            if [ -n "{{DEPLOYED_SHA_JQ}}" ]; then VERIFY+=(--sha-jq="{{DEPLOYED_SHA_JQ}}"); fi
          fi
          bash scripts/record-custom-deployment.sh verify "${VERIFY[@]}"

      - name: Record the successful deployment and start post-deploy verification
        run: |
          bash scripts/record-custom-deployment.sh status --repo="${{ github.repository }}" --deployment-id="${{ steps.deployment.outputs.id }}" --state=success --url="$PROD_URL" --description="Deployed and verified ${DEPLOY_SHA:0:7}"
          gh workflow run post-deploy-prod.yml --repo "${{ github.repository }}" --ref "{{RELEASE_BRANCH}}" -f deployed_sha="$DEPLOY_SHA"

      - name: Record a failed deployment
        if: failure() && steps.deployment.outputs.id != ''
        run: |
          bash scripts/record-custom-deployment.sh status --repo="${{ github.repository }}" --deployment-id="${{ steps.deployment.outputs.id }}" --state=failure --description="Deploy or verification failed for ${DEPLOY_SHA:0:7}" || true
