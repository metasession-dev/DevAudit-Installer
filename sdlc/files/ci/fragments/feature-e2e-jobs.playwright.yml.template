# Fragment of ci.yml (DevAudit-Installer#1335): the feature E2E jobs, Playwright.
# Inserted by the generator's include pass (includeFragments).
  # ──────────────────────────────────────────────
  # E2E scope decision (devaudit-installer#737): a REQ with no tagged test uploads its committed
  # e2e-scope-decision.md. Non-blocking: not judged by the required check (DevAudit-Installer#1335).
  # ──────────────────────────────────────────────
  e2e-scope-decision:
    name: E2E scope decision
    needs: plan
    if: needs.plan.outputs.run_scope_decision == 'true'
    runs-on: {{RUNNER}}
    steps:
      - uses: actions/checkout@v6
        with:
          fetch-depth: 0
          # See the quality-gates job's checkout step for why (devaudit-installer#676/#815).
          clean: {{CHECKOUT_CLEAN}}
      # devaudit-installer#737: has_tests=false is ambiguous by itself — it
      # covers both "sdlc-implementer/e2e-test-engineer deliberately decided
      # no e2e was needed" (a committed compliance/evidence/<REQ>/
      # e2e-scope-decision.md proves it) and "a real coverage gap" (no such
      # file). Upload the artefact when it exists so the deliberate case
      # stops reading as silence beyond this workflow's log; leave the
      # plan job's ::warning:: as the only signal for the genuinely-ambiguous
      # case, per the issue's explicit out-of-scope note.
      - name: Upload e2e-scope-decision evidence, if the deliberate-skip artefact was committed
        env:
          DEVAUDIT_BASE_URL_VAR: ${{ vars.DEVAUDIT_BASE_URL }}
          DEVAUDIT_API_KEY: ${{ secrets.{{API_KEY_SECRET}} }}
        run: |
          REQ_ID="${{ needs.plan.outputs.req_id }}"
          ARTEFACT="compliance/evidence/${REQ_ID}/e2e-scope-decision.md"
          if [ ! -f "$ARTEFACT" ]; then
            echo "No $ARTEFACT on this branch — leaving the has_tests=false warning above as the only signal (ambiguous case, unchanged)."
            exit 0
          fi
          # A co-tracked bundle member's evidence belongs to the core's portal release (#955); $REQ_ID stays the requirement tag (#1323).
          RELEASE_ID=$(cd "$GITHUB_WORKSPACE" && bash scripts/resolve-bundle-release.sh "$REQ_ID") || {
            echo "::error::Could not resolve the portal release for ${REQ_ID} (a co-tracked member of more than one live bundle?)"
            exit 1
          }
          CONFIG_URL=""
          if [ -f "$GITHUB_WORKSPACE/sdlc-config.json" ]; then
            CONFIG_URL=$(jq -r '.devaudit.base_url // empty' "$GITHUB_WORKSPACE/sdlc-config.json" 2>/dev/null || true)
          fi
          BASE="${CONFIG_URL:-$DEVAUDIT_BASE_URL_VAR}"
          if [ -z "$BASE" ] || [ -z "$DEVAUDIT_API_KEY" ]; then
            echo "::warning::DevAudit not configured — skipping e2e-scope-decision upload."
            exit 0
          fi
          export DEVAUDIT_BASE_URL="${BASE%/}"
          chmod +x "$GITHUB_WORKSPACE/scripts/upload-evidence.sh" 2>/dev/null || true
          bash "$GITHUB_WORKSPACE/scripts/upload-evidence.sh" \
            {{PROJECT_SLUG}} "$REQ_ID" e2e_scope_decision "$ARTEFACT" \
            --category planning --release "$RELEASE_ID" --create-release-if-missing \
            --environment uat --sdlc-stage 3 \
            --git-sha "${{ github.event.pull_request.head.sha }}" \
            --branch "${{ github.head_ref }}"

  # ──────────────────────────────────────────────
  # Feature In-Scope E2E (DEVAUDIT-003, issue #174): the specs tagged with the pull request's REQ,
  # uploaded as stage-2, origin=feature evidence. A job of this workflow since DevAudit-Installer#1335,
  # so it is cancelled with the run on a newer push. Non-blocking: not judged by the required check.
  # Specs can tell this job apart with GITHUB_JOB=feature-e2e or DEVAUDIT_E2E_SCOPE=feature.
  # ──────────────────────────────────────────────
  feature-e2e:
    name: Feature In-Scope E2E
    needs: plan
    if: needs.plan.outputs.run_feature == 'true'
    runs-on: {{RUNNER}}

    # See ci.yml.template's quality-gates job for why this exists (#689
    # polyglot-monorepo subdir targets, e.g. a consumer's example-web/).
    # scripts/ stays repo-root-relative below (via $GITHUB_WORKSPACE) since
    # register-release-style tooling lives there regardless of target.
    defaults:
      run:
        working-directory: {{WORKING_DIRECTORY}}

    services:
      {{DATABASE_SERVICE}}:
        image: {{DATABASE_IMAGE}}
{{DATABASE_SERVICE_ENV}}
        ports:
          - {{DATABASE_PORT}}
{{DATABASE_SERVICE_OPTIONS}}

    env:
{{DATABASE_AND_APP_ENV}}
      DEVAUDIT_E2E_SCOPE: feature
      DEVAUDIT_BASE_URL_VAR: ${{ vars.DEVAUDIT_BASE_URL }}
      DEVAUDIT_API_KEY: ${{ secrets.{{API_KEY_SECRET}} }}

    steps:
      - uses: actions/checkout@v6
        with:
          fetch-depth: 0
          # See ci.yml.template's checkout step for why (devaudit-installer#676/#815).
          clean: {{CHECKOUT_CLEAN}}

      - name: Clean stale build and test output (self-hosted only)
        # See ci.yml.template's step of the same name (devaudit-installer#816/#1054).
        if: {{STALE_NEXT_CLEANUP_IF}}
        run: rm -rf .next test-results playwright-report e2e-results.json e2e-auth-results.json e2e-regression-results*.json e2e-regression-metadata.json e2e-server.log .e2e-server.pid test-results-shard-* playwright-report-shard-*
      - uses: actions/setup-node@v6
        with:
          node-version: {{NODE_VERSION}}
      - name: Install dependencies (skip if lockfile unchanged)
        run: |
          LOCK_HASH=$(sha256sum package-lock.json | cut -d' ' -f1)
          if [ -f node_modules/.lock-hash ] && [ "$(cat node_modules/.lock-hash)" = "$LOCK_HASH" ]; then
            echo "node_modules up to date — skipping npm ci"
          else
            npm ci
            echo "$LOCK_HASH" > node_modules/.lock-hash
          fi
      - name: Install Playwright (skip if already cached)
        run: npx playwright install{{PLAYWRIGHT_WITH_DEPS_FLAG}} chromium

{{DATABASE_URI_STEP}}
{{E2E_SETUP_STEP}}
      - name: Kill stale dev server
        # See ci.yml.template's "Kill stale dev server" step for why (devaudit-installer#820).
        run: |
          if lsof -ti:{{E2E_PORT}} >/dev/null 2>&1; then
            lsof -ti:{{E2E_PORT}} | xargs kill -9 2>/dev/null || true
            sleep 1
            if lsof -ti:{{E2E_PORT}} >/dev/null 2>&1; then
              echo "::error::Port {{E2E_PORT}} is still held by another process after a kill attempt (owned by a different user? self-hosted runners are not isolated between jobs). Manual cleanup needed on the runner host before this job can proceed."
              exit 1
            fi
          fi

{{E2E_DEV_SERVER_STEP}}

      - name: Wait for dev server
        # Keep a process-level bound in addition to wait-on's internal timer.
        run: timeout --signal=TERM --kill-after=15s 150s npx wait-on http://localhost:{{E2E_PORT}} --timeout 120000

      # Compute the set of e2e spec files added on this branch (relative
      # to the merge base). The evidenceShot helper reads E2E_NEW_SPECS
      # at capture time and tags each screenshot `origin=feature` when
      # its spec appears in the list, else `origin=regression`.
      - name: Compute new-spec list for E2E origin tagging
        run: |
          BASE_REF="${{ github.base_ref || '{{INTEGRATION_BRANCH}}' }}"
          BASE_SHA=$(git merge-base "origin/${BASE_REF}" HEAD 2>/dev/null || git rev-parse HEAD)
          NEW_SPECS=$(git diff --name-only --diff-filter=A "${BASE_SHA}...HEAD" \
            -- 'tests/e2e/**/*.spec.ts' 'tests/e2e/**/*.spec.tsx' \
               'e2e/**/*.spec.ts' 'e2e/**/*.spec.tsx' 2>/dev/null || true)
          {
            echo "E2E_NEW_SPECS<<EOF"
            echo "$NEW_SPECS"
            echo "EOF"
          } >> "$GITHUB_ENV"
          if [ -n "$NEW_SPECS" ]; then
            echo "New e2e specs on this branch (origin=feature for captures):"
            echo "$NEW_SPECS" | sed 's/^/  /'
          else
            echo "No new e2e specs detected — all captures will tag origin=regression."
          fi

      - name: Register feature release and start feature E2E execution
        id: exec
        if: always()
        run: |
          REQ_ID="${{ needs.plan.outputs.req_id }}"
          # A co-tracked bundle member's evidence belongs to the core's portal release (#955); $REQ_ID stays the requirement tag (#1323).
          RELEASE_ID=$(cd "$GITHUB_WORKSPACE" && bash scripts/resolve-bundle-release.sh "$REQ_ID") || {
            echo "::error::Could not resolve the portal release for ${REQ_ID} (a co-tracked member of more than one live bundle?)"
            exit 1
          }
          : > "$GITHUB_OUTPUT"
          CONFIG_URL=""
          # sdlc-config.json lives at the repo root (#689 follow-up), not this
          # job's working-directory (a target's own subdirectory).
          if [ -f "$GITHUB_WORKSPACE/sdlc-config.json" ]; then
            CONFIG_URL=$(jq -r '.devaudit.base_url // empty' "$GITHUB_WORKSPACE/sdlc-config.json" 2>/dev/null || true)
          fi
          BASE="${CONFIG_URL:-$DEVAUDIT_BASE_URL_VAR}"
          if [ -z "$BASE" ] || [ -z "$DEVAUDIT_API_KEY" ]; then
            echo "::warning::DevAudit not configured — skipping feature E2E test execution lifecycle."
            echo "execution_supported=false" >> "$GITHUB_OUTPUT"
            exit 0
          fi
          export DEVAUDIT_BASE_URL="${BASE%/}"
          chmod +x $GITHUB_WORKSPACE/scripts/upload-evidence.sh $GITHUB_WORKSPACE/scripts/report-test-execution.sh 2>/dev/null || true
          bash $GITHUB_WORKSPACE/scripts/upload-evidence.sh \
            {{PROJECT_SLUG}} _compliance-docs release_registration README.md \
            --release "$RELEASE_ID" --create-release-if-missing \
            --environment uat --category planning \
            --git-sha "${{ github.event.pull_request.head.sha }}" \
            --branch "${{ github.head_ref }}" || true
          bash $GITHUB_WORKSPACE/scripts/report-test-execution.sh start \
            --project-slug {{PROJECT_SLUG}} \
            --release "$RELEASE_ID" \
            --sdlc-stage 2 \
            --environment uat \
            --suite-kind e2e \
            --provider github_actions \
            --external-run-id "${{ github.run_id }}" \
            --external-run-attempt "${{ github.run_attempt }}" \
            --idempotency-key "github:${{ github.repository }}:feature-in-scope-e2e.e2e:${{ github.run_id }}:${{ github.run_attempt }}:2:${REQ_ID}" \
            --commit-sha "${{ github.event.pull_request.head.sha }}" \
            --branch "${{ github.head_ref }}" \
            --workflow-name "Feature In-Scope E2E" \
            --workflow-url "${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}" \
            --output-file "$GITHUB_OUTPUT"

{{E2E_FEATURE_TEST_STEP}}
      - name: Upload feature E2E evidence (stage 2, origin=feature)
        if: always()
        run: |
          REQ_ID="${{ needs.plan.outputs.req_id }}"
          # A co-tracked bundle member's evidence belongs to the core's portal release (#955); $REQ_ID stays the requirement tag (#1323).
          RELEASE_ID=$(cd "$GITHUB_WORKSPACE" && bash scripts/resolve-bundle-release.sh "$REQ_ID") || {
            echo "::error::Could not resolve the portal release for ${REQ_ID} (a co-tracked member of more than one live bundle?)"
            exit 1
          }
          CONFIG_URL=""
          # sdlc-config.json lives at the repo root (#689 follow-up), not this
          # job's working-directory (a target's own subdirectory).
          if [ -f "$GITHUB_WORKSPACE/sdlc-config.json" ]; then
            CONFIG_URL=$(jq -r '.devaudit.base_url // empty' "$GITHUB_WORKSPACE/sdlc-config.json" 2>/dev/null || true)
          fi
          BASE="${CONFIG_URL:-$DEVAUDIT_BASE_URL_VAR}"
          if [ -z "$BASE" ] || [ -z "$DEVAUDIT_API_KEY" ]; then
            echo "::warning::DevAudit not configured — skipping feature E2E upload."
            exit 0
          fi
          export DEVAUDIT_BASE_URL="${BASE%/}"
          if [ -d playwright-report ]; then
            # Traces and videos are left out (e2e_report_include_traces).
            bash "$GITHUB_WORKSPACE/scripts/playwright-report-evidence.sh" zip . feature-e2e 2>&1 || true
          fi
          LINEAGE_FLAGS=(--test-execution "${{ github.run_id }}")
          if [ "${{ steps.exec.outputs.execution_supported }}" = "true" ] && [ -n "${{ steps.exec.outputs.execution_record_id }}" ]; then
            LINEAGE_FLAGS+=(--evidence-scope execution --test-execution-record-id "${{ steps.exec.outputs.execution_record_id }}")
          fi
          UPLOAD_FAILURES=0

          if [ ! -f e2e-results.json ]; then
            echo "::error::Feature E2E produced no e2e-results.json"
            exit 1
          fi
          bash $GITHUB_WORKSPACE/scripts/upload-evidence.sh \
            {{PROJECT_SLUG}} "$REQ_ID" e2e_result e2e-results.json \
            --category e2e_result --release "$RELEASE_ID" --create-release-if-missing \
            --environment uat --sdlc-stage 2 \
            --git-sha "${{ github.event.pull_request.head.sha }}" \
            --ci-run-id "${{ github.run_id }}" --branch "${{ github.head_ref }}" \
            "${LINEAGE_FLAGS[@]}" \
            --meta-key "origin=feature" \
            || UPLOAD_FAILURES=$((UPLOAD_FAILURES + 1))

          SHOT_DIR="compliance/evidence/${REQ_ID}/screenshots"
          shopt -s nullglob
          SHOTS=("${SHOT_DIR}"/*.png)
          shopt -u nullglob
          if [ "${#SHOTS[@]}" -eq 0 ]; then
            # devaudit-installer#1067 — a REQ whose tagged specs are all
            # transport-layer (no Playwright `page`) has nothing to screenshot;
            # its evidence is the JSON report and test-execution-summary.md
            # (e2e-test-engineer skill, "Specs with no page object").
            if bash "$GITHUB_WORKSPACE/scripts/is-transport-layer-req.sh" "$REQ_ID"; then
              echo "::notice::No screenshots for ${REQ_ID}: every spec tagged with it is transport-layer (no page fixture), so there is nothing to capture. Evidence is the e2e JSON report and test-execution-summary.md."
            else
              echo "::error::No evidenceShot screenshots were captured for ${REQ_ID}."
              exit 1
            fi
          fi
          for shot in "${SHOTS[@]}"; do
            bash $GITHUB_WORKSPACE/scripts/upload-evidence.sh \
              {{PROJECT_SLUG}} "$REQ_ID" screenshot "$shot" \
              --category screenshot --release "$RELEASE_ID" --create-release-if-missing \
              --environment uat --sdlc-stage 2 \
              --git-sha "${{ github.event.pull_request.head.sha }}" \
              --ci-run-id "${{ github.run_id }}" --branch "${{ github.head_ref }}" \
              "${LINEAGE_FLAGS[@]}" \
              --meta-key "origin=feature" \
              || UPLOAD_FAILURES=$((UPLOAD_FAILURES + 1))
          done

          if [ -f playwright-report.zip ]; then
            bash $GITHUB_WORKSPACE/scripts/upload-evidence.sh \
              {{PROJECT_SLUG}} "$REQ_ID" feature_e2e_report playwright-report.zip \
              --category e2e_report --release "$RELEASE_ID" --create-release-if-missing \
              --environment uat --sdlc-stage 2 \
              --git-sha "${{ github.event.pull_request.head.sha }}" \
              --ci-run-id "${{ github.run_id }}" --branch "${{ github.head_ref }}" \
              "${LINEAGE_FLAGS[@]}" \
              --meta-key "origin=feature" \
              || echo "::warning::feature E2E report upload failed"
          fi
          if [ "$UPLOAD_FAILURES" -gt 0 ]; then
            echo "::error::${UPLOAD_FAILURES} feature E2E evidence upload(s) failed"
            exit 1
          fi

      - name: Complete feature E2E execution
        if: always()
        run: |
          if [ "${{ steps.exec.outputs.execution_supported }}" != "true" ] || [ -z "${{ steps.exec.outputs.execution_record_id }}" ]; then
            exit 0
          fi
          CONFIG_URL=""
          # sdlc-config.json lives at the repo root (#689 follow-up), not this
          # job's working-directory (a target's own subdirectory).
          if [ -f "$GITHUB_WORKSPACE/sdlc-config.json" ]; then
            CONFIG_URL=$(jq -r '.devaudit.base_url // empty' "$GITHUB_WORKSPACE/sdlc-config.json" 2>/dev/null || true)
          fi
          BASE="${CONFIG_URL:-$DEVAUDIT_BASE_URL_VAR}"
          if [ -z "$BASE" ] || [ -z "$DEVAUDIT_API_KEY" ]; then
            exit 0
          fi
          case "${{ job.status }}" in
            success)   OUTCOME=passed ;;
            cancelled) OUTCOME=cancelled ;;
            *)         OUTCOME=failed ;;
          esac
          REQ_ID="${{ needs.plan.outputs.req_id }}"
          # The execution lives on the bundle core's release, not one named after a co-tracked member (#1323).
          RELEASE_ID=$(cd "$GITHUB_WORKSPACE" && bash scripts/resolve-bundle-release.sh "$REQ_ID") || {
            echo "::error::Could not resolve the portal release for ${REQ_ID} (a co-tracked member of more than one live bundle?)"
            exit 1
          }
          export DEVAUDIT_BASE_URL="${BASE%/}"
          chmod +x $GITHUB_WORKSPACE/scripts/report-test-execution.sh 2>/dev/null || true
          bash $GITHUB_WORKSPACE/scripts/report-test-execution.sh complete \
            --project-slug {{PROJECT_SLUG}} \
            --release "$RELEASE_ID" \
            --sdlc-stage 2 \
            --environment uat \
            --suite-kind e2e \
            --provider github_actions \
            --external-run-id "${{ github.run_id }}" \
            --external-run-attempt "${{ github.run_attempt }}" \
            --idempotency-key "github:${{ github.repository }}:feature-in-scope-e2e.e2e:${{ github.run_id }}:${{ github.run_attempt }}:2:${{ needs.plan.outputs.req_id }}" \
            --commit-sha "${{ github.event.pull_request.head.sha }}" \
            --branch "${{ github.head_ref }}" \
            --workflow-name "Feature In-Scope E2E" \
            --workflow-url "${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}" \
            --started-at "${{ steps.exec.outputs.execution_started_at }}" \
            --outcome "$OUTCOME"
