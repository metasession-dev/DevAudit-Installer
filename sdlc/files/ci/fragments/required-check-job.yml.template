# Fragment of ci.yml (DevAudit-Installer#1335): the required check. Inserted by the generator's include pass (includeFragments).
  # ──────────────────────────────────────────────
  # The required check `Quality Gates` (DevAudit-Installer#1335): it always runs, after the jobs it judges, and
  # passes only when every job the plan asked for succeeded (scripts/ci-required-check.sh). It is the only job
  # with this name. The feature E2E, the scope decision, the evidence upload and the release scope check are
  # not in its `needs`, so they never delay or decide it.
  # ──────────────────────────────────────────────
  required-check:
    name: Quality Gates
    needs: [plan, register-release, quality-gates, release-provenance]
    if: always()
    runs-on: {{RUNNER}}
    permissions:
      contents: read
      # actions: write and pull-requests: read only for re-running a release pull request's checks (D16).
      actions: write
      pull-requests: read
    steps:
      - uses: actions/checkout@v6
        with:
          sparse-checkout: scripts
          clean: {{CHECKOUT_CLEAN}}
      - name: Decide the required check
        env:
          NEEDS_JSON: ${{ toJSON(needs) }}
          GH_TOKEN: ${{ github.token }}
          REPOSITORY: ${{ github.repository }}
          RUN_ID: ${{ github.run_id }}
          RUN_ATTEMPT: ${{ github.run_attempt }}
        run: bash scripts/ci-required-check.sh
      # DevAudit-Installer#1335 D16: Release provenance does not wait for this run (on one runner it would hold the
      # runner this run needs), so when the integration branch passes, re-run the failed checks of an open release
      # pull request whose head is this commit. It never changes the result.
      - name: Re-run the release pull request checks waiting for this commit
        if: ${{ success() && github.event_name != 'pull_request' && github.ref_name == '{{INTEGRATION_BRANCH}}' }}
        continue-on-error: true
        env:
          GH_TOKEN: ${{ github.token }}
          REPOSITORY: ${{ github.repository }}
          HEAD_SHA: ${{ github.sha }}
          RELEASE_BRANCH: {{RELEASE_BRANCH}}
          WORKFLOW_REF: ${{ github.workflow_ref }}
        run: bash scripts/ci-rerun-release-checks.sh
