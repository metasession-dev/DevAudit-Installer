# Release close-out reconciliation — scheduled safety net (devaudit-installer#786).
#
# Generated by `devaudit install` / `devaudit update` from sdlc-config.json.
# Do not edit manually — re-run the CLI (`devaudit update`) to regenerate.
#
# close-out-release.yml normally reconciles a release the moment the portal
# fires its `release-closed` repository_dispatch. That is a single one-shot
# webhook with no consumer-visible retry: if it's ever missed — the send
# failed, or the release never actually reached `released` on the portal via
# the path that fires it (e.g. it was later declared "absorbed" into a
# successor release instead) — the release's ticket can sit un-reconciled in
# compliance/pending-releases/ indefinitely even though its code is already
# live on `main`. See docs/issues/pending-releases-not-closed-out.md and
# docs/release-lineage-and-test-execution-audit-model.md.
#
# This workflow is that safety net: on a daily schedule (plus manual
# workflow_dispatch), it scans compliance/pending-releases/ for tracked
# release tickets whose REQ already has a matching commit reachable from
# origin/main — i.e. the code demonstrably shipped — and, for each one,
# triggers close-out-release.yml's existing reconciliation logic for it
# (rather than duplicating that logic here). It also opens a tracking issue
# summarizing what it found, for auditability, since a missed dispatch is
# exactly the kind of silent failure that goes unnoticed for days.
#
# A no-op run (nothing stale) does nothing further — no issue, no dispatch.

name: Release Close-out Reconciliation

on:
  schedule:
    # Once a day, off-peak UTC. A missed release-closed dispatch is not
    # time-sensitive to catch within minutes — this only needs to run often
    # enough that a stale ticket doesn't sit for more than ~24h.
    - cron: '17 6 * * *'
  workflow_dispatch:
    inputs:
      runner_label:
        description: 'Optional one-run runner label override. Blank uses repository CI_RUNNER_LABEL.'
        required: false

permissions:
  contents: read
  issues: write
  actions: write # to trigger close-out-release.yml via `gh workflow run`

jobs:
  reconcile:
    name: Reconcile stale pending releases
    runs-on: {{RUNNER}}
    env:
      # See close-out-release.yml.template's identical comment —
      # devaudit-installer#613 — this avoids the action_required gate that
      # would otherwise stall the workflow_dispatch triggered below.
      GH_TOKEN: ${{ secrets.INSTALLER_DISPATCH_TOKEN || github.token }}
    steps:
      - uses: actions/checkout@v6
        with:
          ref: develop
          fetch-depth: 0

      - name: Fetch origin/main
        run: git fetch origin main

      - name: Scan for stale pending releases
        id: scan
        run: |
          set -euo pipefail
          chmod +x scripts/close-out-reconcile.sh 2>/dev/null || true
          STALE=$(bash scripts/close-out-reconcile.sh compliance/pending-releases)
          if [ -z "$STALE" ]; then
            echo "No stale pending releases found — origin/main and compliance/pending-releases/ agree."
            echo "found=false" >> "$GITHUB_OUTPUT"
            exit 0
          fi
          echo "found=true" >> "$GITHUB_OUTPUT"
          # Multi-line output: https://docs.github.com/actions/using-workflows/workflow-commands-for-github-actions#multiline-strings
          {
            echo "stale<<STALE_EOF"
            echo "$STALE"
            echo "STALE_EOF"
          } >> "$GITHUB_OUTPUT"
          echo "Stale pending release(s) detected (ticket present, but code already on main):"
          echo "$STALE"

      - name: Trigger close-out-release.yml for each stale release
        if: steps.scan.outputs.found == 'true'
        run: |
          set -euo pipefail
          TRIGGERED=""
          FAILED=""
          while IFS= read -r REQ; do
            [ -n "$REQ" ] || continue
            if gh workflow run close-out-release.yml -f "release=${REQ}"; then
              echo "Triggered close-out-release.yml for ${REQ}."
              TRIGGERED="${TRIGGERED}${REQ} "
            else
              echo "::warning::Failed to trigger close-out-release.yml for ${REQ}."
              FAILED="${FAILED}${REQ} "
            fi
          done <<< "${{ steps.scan.outputs.stale }}"
          echo "TRIGGERED=${TRIGGERED}" >> "$GITHUB_ENV"
          echo "FAILED=${FAILED}" >> "$GITHUB_ENV"

      - name: Open a tracking issue for auditability
        if: steps.scan.outputs.found == 'true'
        run: |
          set -euo pipefail
          RUN_URL="${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}"
          BODY="## Release close-out reconciliation found stale pending release(s)

          The following release ticket(s) in \`compliance/pending-releases/\` are for requirements whose code is already reachable from \`origin/main\`, but whose close-out reconciliation (portal → \`released\` → \`release-closed\` dispatch → this repo's ticket/RTM flip) never ran — likely a missed or failed \`release-closed\` dispatch. See [docs/issues/pending-releases-not-closed-out.md](../blob/develop/docs/issues/pending-releases-not-closed-out.md) for the full failure-mode background.

          **Triggered for automatic reconciliation via \`close-out-release.yml\` (workflow_dispatch):**
          ${TRIGGERED:-none}

          **Failed to trigger (needs manual \`workflow_dispatch\` with \`release=<REQ-XXX>\`):**
          ${FAILED:-none}

          **Detected by:** \`close-out-reconcile.yml\` (devaudit-installer#786) — run: ${RUN_URL}

          This issue is informational — the triggered \`close-out-release.yml\` run(s) above should open their own reconciliation PR(s) shortly if reconciliation succeeds. Close this once you've confirmed those PR(s) merged (or investigated any listed as failed-to-trigger)."
          gh issue create \
            --title "Release close-out reconciliation: stale pending release(s) detected" \
            --body "$BODY" \
            --label "bug" \
            || echo "::warning::Could not open the reconciliation tracking issue."
