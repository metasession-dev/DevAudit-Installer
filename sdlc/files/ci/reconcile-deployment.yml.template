name: Reconcile Verified Host Deployment

# Webhook-loss recovery for the {{HOST}} host adapter (devaudit-installer#841, #1022).
# When the hosting provider deployed correctly but its deployment_status event never
# reached GitHub, the post-deploy gate waits forever. Dispatch this with the provider's
# own deployment id: it is looked up (scripts/lookup-deployment-{{HOST}}.sh), verified
# against the expected SHA and a health probe, and the GitHub deployment status the
# provider failed to post is recorded.

on:
  workflow_dispatch:
    inputs:
      release:
        description: 'REQ-XXX release receiving recovery evidence'
        required: true
      expected_sha:
        description: 'Exact {{RELEASE_BRANCH}} SHA verified at the provider'
        required: true
      github_deployment_id:
        description: 'Existing GitHub deployment ID to reconcile'
        required: true
      provider_deployment_id:
        description: 'Terminal-successful {{HOST}} deployment ID'
        required: true
      provider_project:
        description: '{{HOST}} project ID'
        required: true
      provider_service:
        description: '{{HOST}} service ID or name (leave blank when the host has no services)'
        required: false
      health_url:
        description: 'Configured production health URL'
        required: true
      runner_label:
        description: 'Optional one-run runner label override. Blank uses repository CI_RUNNER_LABEL.'
        required: false

jobs:
  reconcile:
    name: Verify and reconcile deployment
    runs-on: {{RUNNER}}
    permissions:
      contents: read
      deployments: write
    env:
      DEVAUDIT_API_KEY: ${{ secrets.{{API_KEY_SECRET}} }}
      DEVAUDIT_BASE_URL: ${{ vars.DEVAUDIT_BASE_URL }}
    steps:
      - uses: actions/checkout@v6
        with:
          ref: ${{ inputs.expected_sha }}
          # See ci.yml.template's checkout step for why (devaudit-installer#676/#815).
          clean: {{CHECKOUT_CLEAN}}
      - name: Verify provider deployment before reconciliation
        env:
          GH_TOKEN: ${{ github.token }}
          DEVAUDIT_PROBE_HEADER: ${{ secrets.DEVAUDIT_PROBE_HEADER }}
          {{RECONCILE_SECRETS_ENV}}
        run: |
          chmod +x scripts/reconcile-deployment.sh scripts/lookup-deployment-{{HOST}}.sh
          bash scripts/reconcile-deployment.sh \
            --provider="{{HOST}}" \
            --repo="${{ github.repository }}" --sha="${{ inputs.expected_sha }}" \
            --github-deployment-id="${{ inputs.github_deployment_id }}" \
            --provider-deployment-id="${{ inputs.provider_deployment_id }}" \
            --provider-project="${{ inputs.provider_project }}" --provider-service="${{ inputs.provider_service }}" \
            --health-url="${{ inputs.health_url }}"
      - name: Upload manual reconciliation evidence
        run: |
          bash scripts/upload-evidence.sh {{PROJECT_SLUG}} "${{ inputs.release }}" test_report deployment-reconciliation.json \
            --category release_artifact --release "${{ inputs.release }}" --environment production \
            --git-sha "${{ inputs.expected_sha }}" --branch {{RELEASE_BRANCH}} --sdlc-stage 5 \
            --meta-key 'provenance=manual_reconciliation' --meta-key 'provider={{HOST}}'
