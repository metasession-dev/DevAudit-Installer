{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DevAudit framework registry file",
  "description": "One file per compliance framework (SOC 2, ISO 27001, ...): the clauses a project can show evidence for and, for each clause, what the evidence has to be. Published under the repository's Apache-2.0 licence (docs/framework-registry.md). Descriptions are DevAudit's own words and say what a control needs, never how a particular system stores it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["registryVersion", "code", "name", "longName", "edition", "clauses"],
  "properties": {
    "$schema": { "type": "string" },
    "registryVersion": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "The date of the last change to this file." },
    "transcribedFrom": { "type": "string", "description": "Where the content was last transcribed from, for provenance." },
    "code": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "The framework code, as used in a project's list of standards (soc-2, iso-27001, ...)." },
    "name": { "type": "string", "minLength": 1 },
    "longName": { "type": "string", "minLength": 1 },
    "edition": { "type": "string", "minLength": 1, "description": "The edition the clause IDs come from, for example ISO/IEC 27001:2022." },
    "clauses": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/clause" } }
  },
  "definitions": {
    "clause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "expects"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9]+\\.[A-Za-z0-9.-]+$" },
        "title": { "type": "string", "minLength": 1, "description": "The short published control title only; no text of a standard is reproduced." },
        "idEdition": { "type": "string", "minLength": 1, "description": "The edition this ID comes from, only when it differs from the framework's edition." },
        "note": { "type": "string", "minLength": 1, "description": "One sentence; required whenever idEdition is present." },
        "equivalents2022": { "type": "array", "items": { "type": "string" }, "description": "Clause IDs from the framework's own edition that replace this one; empty or absent until the compliance reader answers." },
        "expects": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/expectation" } }
      },
      "dependencies": { "idEdition": ["note"] }
    },
    "expectation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "types", "description"],
          "properties": {
            "kind": { "const": "evidence_type_any" },
            "types": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" }, "description": "Evidence types from contracts/evidence-types.json; any one satisfies." },
            "freshnessDays": { "type": "integer", "minimum": 1 },
            "description": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "fileNames", "description"],
          "properties": {
            "kind": { "const": "evidence_filename_any" },
            "fileNames": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
            "freshnessDays": { "type": "integer", "minimum": 1 },
            "description": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "eventTypes", "description"],
          "properties": {
            "kind": { "const": "audit_event_any" },
            "eventTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
            "description": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "riskClass", "description"],
          "properties": {
            "kind": { "const": "requirement_meta" },
            "riskClass": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
            "description": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "description"],
          "properties": {
            "kind": { "const": "portal_invariant" },
            "description": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "expectations", "description"],
          "properties": {
            "kind": { "const": "any_of" },
            "expectations": { "type": "array", "minItems": 2, "items": { "$ref": "#/definitions/expectation" } },
            "description": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
